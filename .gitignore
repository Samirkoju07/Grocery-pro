__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
htmlcov/
.coverage
coverage.xml
*.cover
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# Node / npm
node_modules/
dist/
build/
.next/
.nuxt/
.output/
*.tsbuildinfo

# Tauri
target/
*.app
*.dmg
*.deb
*.AppImage
*.msi
*.exe
*.zip
*.tar.gz

# Docker
docker/postgres/data/

# IDE / Editor
.vscode/settings.json
.idea/
*.swp
*.swo
*.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Alembic
alembic/versions/*.pyc
